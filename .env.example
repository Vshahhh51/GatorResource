# Server-only. Copy to .env.local; never use a NEXT_PUBLIC_ prefix.
# Gemini API key (from Google AI Studio). If set, it is used instead of Vertex AI/ADC.
GEMINI_API_KEY=
# Only needed for Vertex AI with ADC (Cloud Run) when GEMINI_API_KEY is empty.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash

# Random string used to sign login cookies. Set a stable value in Cloud Run.
SESSION_SECRET=
